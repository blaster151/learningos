# ===================================
# Test Environment Variables
# ===================================
# Used by Playwright E2E tests when running with Firebase emulators

# Enable Firebase Emulators
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Firebase Configuration (still needed for initialization)
NEXT_PUBLIC_FIREBASE_API_KEY=test-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=learningos-2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=learningos-2026.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=92258811835
NEXT_PUBLIC_FIREBASE_APP_ID=1:92258811835:web:test
